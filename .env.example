# ---------------------------------------------------------------------------
# Autopilot Trader — configuration
#
# Everything here has a safe default. The bot runs in PAPER mode with no
# credentials at all. Fill in the marked values only when you want more.
# ---------------------------------------------------------------------------

# ---- Mode ------------------------------------------------------------------
# paper  = real market data, simulated money. No API keys needed. No risk.
# live   = real orders on the exchange. Requires API keys below.
BOT_MODE=paper

# ---- Exchange --------------------------------------------------------------
# Binance spot. Use the testnet URL first to prove the live code path:
#   https://testnet.binance.vision
BINANCE_BASE_URL=https://api.binance.com

# Create at Exchange -> API Management. Grant ONLY "Enable Spot & Margin
# Trading". Never enable withdrawals. The bot never needs them.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- Market / strategy -----------------------------------------------------
SYMBOL=BTCUSDT
# trend    = daily regime switch (few trades a year, most robust)
# pullback = hourly oversold dips inside an uptrend (more trades)
STRATEGY=trend

# ---- Capital & risk --------------------------------------------------------
# Fraction of free cash committed per position (0-1).
POSITION_FRACTION=0.97
# Stop trading for a while if equity drops this far below its peak.
MAX_DRAWDOWN=0.30
# Stop for the rest of the UTC day if equity drops this much today.
MAX_DAILY_LOSS=0.08
MAX_CONSECUTIVE_LOSSES=5
HALT_DAYS=7
COOLDOWN_HOURS=4

# ---- Adaptive sizing (see docs/ADAPTIVE.md) --------------------------------
# Size positions against measured volatility instead of a fixed fraction.
ADAPTIVE_SIZING=false
TARGET_VOL=0.40
VOL_WINDOW=20
VOL_BASELINE_WINDOW=200
ADAPTIVE_MIN_SCALE=0.25
# 1 = only ever reduce risk. Raise to allow leaning in, up to 100% of cash.
ADAPTIVE_MAX_SCALE=1
STORM_VOL_MULTIPLE=2.0
STORM_SCALE=0.5
CALM_VOL_MULTIPLE=0.7

# ---- Ensemble (see docs/ENSEMBLE.md) ---------------------------------------
# STRATEGY=ensemble activates regime detection + family competition.
ENSEMBLE_SCORE_WINDOW=250
ENSEMBLE_RSI_PERIOD=14
ENSEMBLE_RSI_ENTRY=35
ENSEMBLE_RSI_EXIT=55
# Force cash during a volatility storm, whatever the family scores say.
ENSEMBLE_STORM_BLOCKS=true

# ---- Storage (Supabase) ----------------------------------------------------
# Server-side only. This is the service_role key; never expose it publicly.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Endpoint protection ---------------------------------------------------
# Vercel cron sends this automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Optional: require this token on /api/status.
DASHBOARD_TOKEN=

# ---- Optional notifications ------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Emergency stop --------------------------------------------------------
# Set to true and every new entry is blocked. Exits still run.
KILL_SWITCH=false

# ---- Instrument & costs ----------------------------------------------------
# Exchange minimum order size. The status page uses this to tell you when a
# balance is too small to place any order at all.
MIN_NOTIONAL=5
# Starting paper balance, and the anchor of the goal line.
PAPER_START_USDT=10
# The stated goal, in USDT per day. Reported against, never traded toward.
GOAL_DAILY_TARGET=1
# Taker fee per side (0.001 = 0.1%) and assumed slippage in basis points.
FEE_RATE=0.001
SLIPPAGE_BPS=2

# ---- Endpoint exposure -----------------------------------------------------
# POST /api/tick needs CRON_SECRET once you are live (Vercel's cron sends it).
# GET /api/status needs DASHBOARD_TOKEN if you do not want the numbers public.
# GET /api/backtest is closed unless one of those is set, or you opt in here:
PUBLIC_BACKTEST=false

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=info

# ---- Trend strategy --------------------------------------------------------
TREND_EMA_PERIOD=200
# Enter this far above the EMA, exit this far below it. Both must be >= 0, so a
# single candle can never satisfy both.
TREND_ENTRY_BUFFER=0.005
TREND_EXIT_BUFFER=0.005
# Catastrophic stop, measured on the daily close (never on a wick).
TREND_CRASH_STOP=0.25

# ---- Pullback strategy (hourly) -------------------------------------------
PULLBACK_RSI_PERIOD=14
PULLBACK_OVERSOLD=35
PULLBACK_ATR_PERIOD=14
PULLBACK_SL_ATR_MULT=2
PULLBACK_TP_ATR_MULT=3
PULLBACK_SL_PCT=0.03
PULLBACK_TP_PCT=0.06
PULLBACK_MAX_HOLD_HOURS=72
