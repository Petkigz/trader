# ---------------------------------------------------------------------------
# Autopilot Trader — configuration
#
# Everything here has a safe default. The bot runs in PAPER mode with no
# credentials at all. Fill in the marked values only when you want more.
# ---------------------------------------------------------------------------

# ---- Mode ------------------------------------------------------------------
# paper  = real market data, simulated money. No API keys needed. No risk.
# live   = real orders on the exchange. Requires API keys below.
BOT_MODE=paper

# ---- Exchange --------------------------------------------------------------
# Binance spot. Use the testnet URL first to prove the live code path:
#   https://testnet.binance.vision
BINANCE_BASE_URL=https://api.binance.com

# Create at Exchange -> API Management. Grant ONLY "Enable Spot & Margin
# Trading". Never enable withdrawals. The bot never needs them.
BINANCE_API_KEY=
BINANCE_API_SECRET=

# ---- Market / strategy -----------------------------------------------------
SYMBOL=BTCUSDT
# trend    = daily regime switch (few trades a year, most robust)
# pullback = hourly oversold dips inside an uptrend (more trades)
STRATEGY=trend

# ---- Capital & risk --------------------------------------------------------
# Fraction of free cash committed per position (0-1).
POSITION_FRACTION=0.97
# Stop trading for a while if equity drops this far below its peak.
MAX_DRAWDOWN=0.30
# Stop for the rest of the UTC day if equity drops this much today.
MAX_DAILY_LOSS=0.08
MAX_CONSECUTIVE_LOSSES=5
HALT_DAYS=7
COOLDOWN_HOURS=4

# ---- Adaptive sizing (see docs/ADAPTIVE.md) --------------------------------
# Size positions against measured volatility instead of a fixed fraction.
ADAPTIVE_SIZING=false
TARGET_VOL=0.40
VOL_WINDOW=20
VOL_BASELINE_WINDOW=200
ADAPTIVE_MIN_SCALE=0.25
# 1 = only ever reduce risk. Raise to allow leaning in, up to 100% of cash.
ADAPTIVE_MAX_SCALE=1
STORM_VOL_MULTIPLE=2.0
STORM_SCALE=0.5
CALM_VOL_MULTIPLE=0.7

# ---- Storage (Supabase) ----------------------------------------------------
# Server-side only. This is the service_role key; never expose it publicly.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Endpoint protection ---------------------------------------------------
# Vercel cron sends this automatically as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=
# Optional: require this token on /api/status.
DASHBOARD_TOKEN=

# ---- Optional notifications ------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Emergency stop --------------------------------------------------------
# Set to true and every new entry is blocked. Exits still run.
KILL_SWITCH=false
