{
  "name": "autopilot-trader",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A zero-maintenance, zero-dependency crypto trading bot designed to run unattended on $10 forever.",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {
    "dev": "node scripts/dev-server.ts",
    "tick": "node --env-file-if-exists=.env src/cli/tick.ts",
    "backtest": "node --env-file-if-exists=.env src/cli/backtest.ts",
    "research": "node --env-file-if-exists=.env src/cli/research.ts",
    "status": "node --env-file-if-exists=.env src/cli/status.ts",
    "lock": "node --env-file-if-exists=.env src/cli/halt.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --test test/*.test.ts",
    "verify": "npm run typecheck && npm test",
    "xsection": "node --experimental-strip-types scripts/xsection.ts",
    "xsmom": "node --experimental-strip-types scripts/xsmom.ts",
    "challenger": "node --experimental-strip-types scripts/challenger.ts",
    "catchup": "node --experimental-strip-types scripts/catchup.ts",
    "recover": "node --experimental-strip-types scripts/recover.ts",
    "growth": "node --experimental-strip-types scripts/growth.ts",
    "context": "node --experimental-strip-types scripts/context.ts",
    "fetch:volume": "node --experimental-strip-types scripts/fetch-volume.ts"
  },
  "dependencies": {},
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.7.0"
  }
}
